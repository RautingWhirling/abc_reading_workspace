    "98479": {
        "user_id": 98479,
        "user_name": "user_98479",
        "user_followers": 11877,
        "user_friends": 1745,
        "user_interests": [
            "旅游",
            "自然风光",
            "牯牛降风景区",
            "黄山山脉"
        ],
        "user_description": "牯牛降风景区是安徽南部三大高山(黄山、清凉峰、牯牛降)之一，距石台县城22公里，主峰海拔1727.6米，总面积为6700公顷。牯牛降共分五大景区:主峰景区、灵山景区、双龙谷景区、龙门景区、观音堂景区。其中前四个皆位于石台县境内，牯牛降以雄、奇、险著称，是黄山山脉向西延伸的主体，古称\"西黄山\"，山岳风光秀美绮丽。境内有36大峰，72小峰，36大岔，72小岔。因其山形酷似一头牯牛从天而降，故名牯牛降。"
    },
